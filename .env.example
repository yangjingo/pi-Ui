# Core layer (server-side) configuration. Copy to `.env` and edit.
# These are NEVER exposed to the browser (no VITE_ prefix).

# Preferred model as provider/model. If it isn't authenticated, the runtime auto-
# selects the first available one (from `pi login`).
PI_MODEL=deepseek/deepseek-v4-flash

# Working directory the agent reads/writes files in (created if missing).
PI_CWD=./workspace

# --- Authentication -------------------------------------------------------
# The runtime uses whatever you configured with `pi login` (stored in
# ~/.pi/agent/auth.json). In this project that is **deepseek**.
#
# A real Anthropic key also works if you have one:
#   ANTHROPIC_API_KEY=sk-ant-...
#
# NOTE on the Claude/GLM proxy: Claude Code on this machine talks to a GLM proxy
# via ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN. That token CANNOT be reused here —
# Pi's built-in anthropic provider hardcodes https://api.anthropic.com and ignores
# ANTHROPIC_BASE_URL. Use a `pi login` provider (deepseek) instead.
